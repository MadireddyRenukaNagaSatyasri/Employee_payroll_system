# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/employee_payroll_db

# JWT Authentication Secret & Token Expiration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_123456
JWT_EXPIRES_IN=1d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
