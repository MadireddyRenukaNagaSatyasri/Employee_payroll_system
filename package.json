{
  "name": "employee-payroll-management-system",
  "version": "1.0.0",
  "description": "Full-Stack MERN Employee Payroll Management System",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install --include=dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "npm --prefix server run seed",
    "seed:admin": "npm --prefix server run seed:admin",
    "test:e2e": "npm --prefix server run test:e2e",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "keywords": [
    "mern",
    "mongodb",
    "express",
    "react",
    "vite",
    "tailwind",
    "payroll",
    "hr-system"
  ],
  "author": "Antigravity Senior MERN Stack Team",
  "license": "ISC"
}
